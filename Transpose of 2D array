
package transpose;
import java.util.Scanner;

public class Transpose {

	public static void main(String[] args) {
		
		Scanner sc=new Scanner(System.in);
		int r=2;
		int c=2;
		
		int[][] arr =new int[r][c];
		for(int i=0;i<r;i++) {
			for(int j=0;j<c;j++) {
				arr[i][j]=sc.nextInt();
				
			}
		}
		
		for(int i=0;i<r;i++) {
			for(int j=0;j<c;j++) {
				System.out.print(arr[i][j]+" ");
			}
			System.out.println();
		}
		
		for(int j=0;j<c;j++) {
			for(int i=0;i<r;i++) {
				System.out.print(arr[i][j] + " ");
			}
			System.out.println();
		}

	}

}
